###############################################################################
# Copier ce fichier en .env pour le développement local :
#   copier .env.example -> .env
#
# Pour le déploiement Vercel + Neon, renseigner CES MEMES variables dans :
#   Vercel -> Projet -> Settings -> Environment Variables
###############################################################################

# --- Base de données (Neon) --------------------------------------------------
# Dans Neon : Dashboard -> Branches -> votre branche -> Connection Details
# Choisir la chaîne "Connection string" (driver Node.js / postgres).
# Neon exige SSL (géré automatiquement par le code via "neon.tech").
#
# Exemple :
#   postgresql://neondb_owner:<PASSWORD>@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_fOyaj8QnYJ1S@ep-cool-base-a53mk888-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Nombre max de connexions au pool (rester petit en mode serverless Vercel).
# Neon supporte le pooling élastique ; 3 suffit pour un usage Vercel.
PG_MAX_POOL=3

# --- Sécurité ---------------------------------------------------------------
# Changez cette valeur en production (longue et aléatoire).
JWT_SECRET=change_me_in_production_use_a_long_random_string

# --- Serveur ----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- Optionnel : création du compte admin -----------------------------------
# Utilisé par : npm run db:seed
SEED_ADMIN_EMAIL=admin@neobank.local
SEED_ADMIN_PASSWORD=Admin123!
